# Copy this file to .env and fill it in. Never share or commit .env.

# Option A (recommended): your Azure sign-in, no keys. Run `az login` first.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5.4-mini

# Option B (quick demo fallback): API key from the Foundry resource (Keys and Endpoint).
# If AZURE_OPENAI_API_KEY is set, the app uses this instead of Option A.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
